# Copy to .env and fill in the platforms you want to use.
# Platforms without credentials are skipped and reported as "Not configured".

REQUEST_TIMEOUT=15

# Strongly recommended: clients must send this value in the X-API-Key header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Max POST /posting requests per client IP per minute
RATE_LIMIT_PER_MINUTE=10

# Telegram: create a bot with @BotFather, add it as admin to your channel.
# Use "@channelname" for a public channel or the numeric id (-100...) for a private one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Mastodon: Preferences -> Development -> New application (scope: write:statuses)
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: Settings -> Privacy and security -> App passwords
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# GitHub: fine-grained or classic personal access token with the "gist" scope
GITHUB_TOKEN=

# Telegraph: see README for the one-line createAccount call that returns a token
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_AUTHOR_NAME=
